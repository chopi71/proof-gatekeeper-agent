# Copy to .env and fill in. NEVER commit a real .env.
# Port the agent listens on (TLS is terminated by the tunnel/host in front).
PORT=8080
# Platform-generated HMAC secret for this agent (dashboard -> agent settings ->
# Rotate Secret; shown exactly once). Placeholder below is NOT a real secret.
AGENT_GAMES_HMAC_SECRET=replace-me-with-the-real-secret-from-the-dashboard
# Optional: Kurier API key. If unset, Kurier submission is skipped silently.
KURIER_API_KEY=
# Directory holding gatekeeper.wasm + gatekeeper_final.zkey (default: ../circuits).
CIRCUITS_DIR=../circuits
# Persistent seen-set of proof_tx values (default: ./seen.json).
SEEN_FILE=./seen.json
